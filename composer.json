{
    "name": "glue-systems/filament-filter-presets",
    "description": "A Filament plugin to save and load filter presets",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filters",
        "presets",
        "tables",
        "ui"
    ],
    "authors": [
        {
            "name": "Glue Systems",
            "email": "dev@walts.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Guiu\\FilamentFilterPresets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guiu\\FilamentFilterPresets\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guiu\\FilamentFilterPresets\\FilamentFilterPresetsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
